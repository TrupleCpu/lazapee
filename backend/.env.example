# Lazapee backend environment variables
# Copy this file to `.env` and fill in your values.
# WARNING: Never commit the real `.env` file.

# --- Supabase (database) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Secret used to sign admin JWT tokens
JWT_SECRET=

# --- Appwrite (image storage) ---
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_BUCKET_ID=
APPWRITE_API_KEY=

# --- Optional ---
# Allowed CORS origin (frontend URL). Defaults to http://localhost:5173
CLIENT_URL=

# API port for local development. Defaults to 3000
PORT=